.settings/

# Mac & Windows specific
.DS_Store
Thumbs.db

# Runtime files
.env
.env.local
.env.development.local
.env.production.local

# Handoff files
HANDOFF.md
design_handoff_fabula_redesign/

# Local working notes — scratch analysis, not repo documentation
notes/
# Test artifacts
coverage/
responsive-shots/

# Eval run artifacts (regenerated by npm run eval / npm run eval:live; never hand-edited)
evals/report.json
evals/report.md

# Bench run artifacts (regenerated by npm run bench; never hand-edited). bench/BASELINE.md
# is the one committed exception — the measured main baseline plans 2 and 3 compare against.
bench/results/

# graphify knowledge graph (regenerable via /graphify; extraction cache backed up
# outside the repo at ~/.cache/graphify/fabula/ so a branch switch can't lose it)
graphify-out/

# Playwright E2E artifacts
e2e/.playwright/
playwright-report/
test-results/

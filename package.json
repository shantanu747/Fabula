{
  "name": "fabula",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:perf": "vitest run --config vitest.perf.config.mts",
    "test:coverage": "vitest run --coverage",
    "eval": "vitest run --config vitest.eval.config.mts",
    "eval:record": "node --env-file-if-exists=.env.local ./node_modules/.bin/tsx evals/record.ts",
    "eval:live": "node --env-file-if-exists=.env.local ./node_modules/.bin/tsx evals/run.ts --live --full",
    "db:generate": "node --env-file=.env.local ./node_modules/.bin/drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local ./node_modules/.bin/drizzle-kit migrate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@auth/drizzle-adapter": "^1.11.3",
    "@neondatabase/serverless": "^1.1.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "openai": "^7.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "fast-check": "^4.9.0",
    "pg": "^8.23.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "tsx": "4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}

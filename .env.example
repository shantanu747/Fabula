ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional — eval/E2E harness override (points the real adapter at the local mock
# provider), also usable for a self-hosted gateway. Leave blank in normal use.
ANTHROPIC_BASE_URL=
OPENAI_BASE_URL=
OPENROUTER_BASE_URL=

# Optional — OpenRouter leaderboard attribution only, safe to leave blank
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=

# Postgres connection string (e.g. from a Neon project) — required for accounts,
# saved stories, and the shared feed. Guest (logged-out) writing works without it.
DATABASE_URL=

# Auth.js session/JWT signing secret. Generate with: npx auth secret
AUTH_SECRET=

# Google OAuth client, from https://console.cloud.google.com/apis/credentials
# (only needed to enable "Continue with Google" — email/password works without it)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenTelemetry — standard OTLP env vars, no code change needed to switch backends.
# Unset means no exporter is configured and instrumentation is inert.
OTEL_SERVICE_NAME=fabula
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Content-Security-Policy escape hatch (src/proxy.ts). Unset (the default) enforces
# the policy. Set to "true" only to diagnose a CSP-related production incident by
# switching to Content-Security-Policy-Report-Only without a redeploy of the policy
# itself — not a normal development setting.
CSP_REPORT_ONLY=

# Optional — Upstash/Vercel KV REST credentials (docs/adr/0035). Entirely optional:
# the app runs without Redis, falling back to Postgres-only rate limiting with no
# concurrency or spend caps. See README's "Developing against local Redis" for a
# local serverless-redis-http container that speaks the same protocol.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional — how many trusted proxy hops sit in front of this deployment and
# append to x-forwarded-for (docs/adr/0036). Defaults to 1, which is correct on
# Vercel. Only change this behind a different, self-hosted ingress topology.
TRUSTED_PROXY_HOP_COUNT=

# Required only if src/app/api/cron/prune/route.ts is scheduled (vercel.json) —
# a long random secret the cron caller sends as `Authorization: Bearer <value>`.
# Generate with: openssl rand -hex 32
CRON_SECRET=
